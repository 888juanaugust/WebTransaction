    string status
    bigint sales_user_id FK
    bigint marketing_user_id FK
    bigint region_id FK
  }
  customer_users {
    bigint id PK
    bigint company_id FK
    string email
    bool is_active
  }
  carts {
    bigint id PK
    bigint company_id FK
    bigint customer_user_id FK
    bigint warehouse_id FK
    bigint region_id FK
  }
  cart_items {
    bigint id PK
    bigint cart_id FK
    string sku FK
    string ordered_unit
    int ordered_qty
  }
  quotations {
    bigint id PK
    string nomor
    bigint company_id FK
    string status
    date valid_until
    bigint total_rupiah
    bigint order_id FK
    bigint region_id FK
  }
  quotation_lines {
    bigint id PK
    bigint quotation_id FK
    string sku FK
    int qty_base
    bigint unit_price_rupiah
    bigint line_total_rupiah
  }
  orders {
    bigint id PK
    string nomor
    bigint company_id FK
    bigint warehouse_id FK
    string status
