    bigint id PK
    string kode
    string nama
  }
  warehouses {
    bigint id PK
    string kode
    string nama
    bigint region_id FK
  }
  users {
    bigint id PK
    string name
    string role
    bool is_active
    bigint region_id FK
    bigint warehouse_id FK
  }
  companies {
    bigint id PK
    string kode
    string nama
    string npwp
    bigint price_tier_id FK
