    bigint placed_by_customer_user_id FK
    bigint split_parent_id FK
    bigint region_id FK
  }
  order_lines {
    bigint id PK
    bigint order_id FK
    string sku FK
    string ordered_unit
    bigint qty_base
    bigint line_total_rupiah
    bigint dpp_rupiah
    bigint ppn_rupiah
    bigint price_list_version_id FK
    string price_reason
  }
  order_events {
    bigint id PK
    bigint order_id FK
    string from_status
    string to_status
    bigint actor_id FK
    text alasan
    bigint customer_actor_id FK
  }
  stock_reservations {
    bigint id PK
    bigint order_id FK
    bigint order_line_id FK
    string sku FK
    bigint warehouse_id FK
    bigint qty_base
    string status
    bigint region_id FK
  }
  invoices {
    bigint id PK
    string nomor
    bigint order_id FK
    bigint company_id FK
    bigint total_rupiah
    date issued_on
    date due_date
    string status
    string nsfp
    bigint region_id FK
  }
  payment_entries {
    bigint id PK
