APP_NAME="WebTransaction"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webtransaction
DB_USERNAME=webtransaction
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production — the cookie must never travel over plain http.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Profil perusahaan. Everything the public site shows about the company.
# The defaults in config/perusahaan.php are PLACEHOLDER — set these before the
# site is published. Partners and profile copy live in that file, not here.
PERUSAHAAN_NAMA="PT Java Indo Intermechanika"
PERUSAHAAN_NAMA_SINGKAT="Java Indo"
PERUSAHAAN_ALAMAT=
PERUSAHAAN_KOTA=
PERUSAHAAN_TELEPON=
PERUSAHAAN_WHATSAPP=
PERUSAHAAN_EMAIL=
PERUSAHAAN_NIB=
PERUSAHAAN_NPWP=
PERUSAHAAN_TAHUN=

# Path to the company mark, relative to public/ — e.g. images/logo.svg.
# Leave empty until the file is committed: every surface falls back to the
# wordmark, and a path pointing at a missing file is ignored rather than
# rendered as a broken image.
PERUSAHAAN_LOGO=images/logo.svg

# Wilayah pertama, dibuat otomatis oleh migrasi. Kode ini masuk ke setiap
# nomor dokumen wilayah tersebut (INV-SBY-202608-0001) dan tidak bisa diubah
# setelah ada dokumen — isi sebelum migrasi pertama di produksi.
WILAYAH_UTAMA_KODE=SBY
WILAYAH_UTAMA_NAMA=Surabaya

# Rekening perusahaan — tercetak di faktur dan portal sebagai tujuan transfer.
# Tidak ada gateway pembayaran; finance mengonfirmasi setiap pembayaran.
PERUSAHAAN_BANK=BCA
PERUSAHAAN_REKENING=
PERUSAHAAN_REKENING_NAMA=

# Pajak (PPN). Headline 12%, DPP faktor 11/12 for ordinary goods (PMK 131/2024).
PPN_RATE_BPS=1200
PPN_DPP_NUMERATOR=11
PPN_DPP_DENOMINATOR=12
PPN_TRANSACTION_CODE=04

# Faktur pajak export. `coretax_xml` is the Coretax bulk-import XML and is what
# to file with; `efaktur_csv` is the old desktop e-Faktur CSV, kept only so a
# filing made under it can be reproduced.
PAJAK_FORMAT_EKSPOR=coretax_xml

# Penjual on every faktur. NPWP and NAMA are normally typed into
# Pengaturan → Pengaturan perusahaan (audited); these are the fallback.
# ID TKU (NITKU) is 22 digits — NPWP 16 digit + kode cabang. Leave empty for a
# head office and the system uses NPWP + 000000.
PAJAK_PENJUAL_NPWP=
PAJAK_PENJUAL_NAMA=
PAJAK_PENJUAL_ALAMAT=
PAJAK_PENJUAL_ID_TKU=

# Coretax's own reference codes, not ours. >>> PERIKSA with the accountant
# before the first real filing; the Faktur pajak screen prints the values in
# use. IDN is Indonesia in ISO 3166-1 alpha-3 (the sample template read IND,
# which is India). UM.0001 is what that template carried for a line of goods.
PAJAK_NEGARA_PEMBELI=IDN
PAJAK_KODE_BARANG=000000
PAJAK_SATUAN_PCS=UM.0001
PAJAK_SATUAN_SET=UM.0001

# Stale unpaid orders release their stock reservation after this many minutes.
RESERVATION_TTL_MINUTES=2880

VITE_APP_NAME="${APP_NAME}"
