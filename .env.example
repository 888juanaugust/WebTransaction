APP_NAME="WebTransaction"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webtransaction
DB_USERNAME=webtransaction
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Profil perusahaan. Everything the public site shows about the company.
# The defaults in config/perusahaan.php are PLACEHOLDER — set these before the
# site is published. Partners and profile copy live in that file, not here.
PERUSAHAAN_NAMA="PT Java Indo Intermechanika"
PERUSAHAAN_NAMA_SINGKAT="Java Indo"
PERUSAHAAN_ALAMAT=
PERUSAHAAN_KOTA=
PERUSAHAAN_TELEPON=
PERUSAHAAN_WHATSAPP=
PERUSAHAAN_EMAIL=
PERUSAHAAN_NIB=
PERUSAHAAN_NPWP=
PERUSAHAAN_TAHUN=

# Path to the company mark, relative to public/ — e.g. images/logo.svg.
# Leave empty until the file is committed: every surface falls back to the
# wordmark, and a path pointing at a missing file is ignored rather than
# rendered as a broken image.
PERUSAHAAN_LOGO=images/logo.svg

# Wilayah pertama, dibuat otomatis oleh migrasi. Kode ini masuk ke setiap
# nomor dokumen wilayah tersebut (INV-PST-202608-0001) dan tidak bisa diubah
# setelah ada dokumen — isi sebelum migrasi pertama di produksi.
WILAYAH_UTAMA_KODE=PST
WILAYAH_UTAMA_NAMA=Pusat

# Xendit — fixed Virtual Account. Sandbox keys in development.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co

# Pajak (PPN). Headline 12%, DPP faktor 11/12 for ordinary goods (PMK 131/2024).
PPN_RATE_BPS=1200
PPN_DPP_NUMERATOR=11
PPN_DPP_DENOMINATOR=12
PPN_TRANSACTION_CODE=04

# Stale unpaid orders release their stock reservation after this many minutes.
RESERVATION_TTL_MINUTES=2880

VITE_APP_NAME="${APP_NAME}"
